# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{c,h,cpp,hpp}]
indent_size = 4
max_line_length = 100

[*.{rs,toml}]
indent_size = 4
max_line_length = 100

[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,md}]
indent_size = 2
max_line_length = 120

[Makefile]
indent_style = tab
